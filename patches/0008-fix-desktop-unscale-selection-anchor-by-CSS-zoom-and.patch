@@ -2,7 +2,7 @@ import { describe, expect, it } from 'vitest'
 
 import { isComposerChord } from '@/lib/keybinds/chords'
 
-import { isMacPlatform, shouldOwnAddSelectionShortcut } from './selection'
+import { isMacPlatform, shouldOwnAddSelectionShortcut, terminalSelectionAnchor } from './selection'
 
 const key = (init: Partial<KeyboardEvent> & { key: string }) =>
   ({
@@ -34,3 +34,22 @@ describe('shouldOwnAddSelectionShortcut', () => {
     expect(isComposerChord(chord)).toBe(true)
   })
 })
+
+describe('terminalSelectionAnchor', () => {
+  it('unscales selection rect deltas by currentCSSZoom so Add to chat aligns under browser zoom', () => {
+    const host = document.createElement('div')
+    const selectionLayer = document.createElement('div')
+    selectionLayer.className = 'xterm-selection'
+    const band = document.createElement('div')
+    selectionLayer.appendChild(band)
+    host.appendChild(selectionLayer)
+
+    Object.defineProperty(host, 'clientWidth', { configurable: true, value: 400 })
+    Object.defineProperty(host, 'clientHeight', { configurable: true, value: 200 })
+    Object.defineProperty(host, 'currentCSSZoom', { configurable: true, value: 1.25 })
+    host.getBoundingClientRect = () => ({ left: 100, top: 200, right: 600, bottom: 450, width: 500, height: 250 }) as DOMRect
+    band.getBoundingClientRect = () => ({ left: 225, top: 250, right: 325, bottom: 275, width: 100, height: 25 }) as DOMRect
+
+    expect(terminalSelectionAnchor(host)).toEqual({ left: 100, top: 64 })
+  })
+})
diff --git a/apps/desktop/src/app/right-sidebar/terminal/selection.ts b/apps/desktop/src/app/right-sidebar/terminal/selection.ts
index 6042cd2328..76e3bd5bf6 100644
--- a/apps/desktop/src/app/right-sidebar/terminal/selection.ts
+++ b/apps/desktop/src/app/right-sidebar/terminal/selection.ts
@@ -131,9 +131,17 @@ export function terminalSelectionAnchor(host: HTMLDivElement): CSSProperties | n
   }
 
   const hostRect = host.getBoundingClientRect()
+  const cssZoom =
+    (host as HTMLElement & { currentCSSZoom?: number }).currentCSSZoom ||
+    (typeof document !== 'undefined' ? Number.parseFloat(document.documentElement.style.zoom) : 1) ||
+    1
+  const zoom = Number.isFinite(cssZoom) && cssZoom > 0 ? cssZoom : 1
   const buttonWidth = 128
-  const left = Math.min(Math.max(rect.left - hostRect.left, 8), Math.max(8, host.clientWidth - buttonWidth - 8))
-  const top = Math.min(Math.max(rect.bottom - hostRect.top + 4, 8), Math.max(8, host.clientHeight - 34))
+  const left = Math.min(
+    Math.max((rect.left - hostRect.left) / zoom, 8),
+    Math.max(8, host.clientWidth - buttonWidth - 8)
+  )
+  const top = Math.min(Math.max((rect.bottom - hostRect.top) / zoom + 4, 8), Math.max(8, host.clientHeight - 34))
 
   return { left, top }
 }
